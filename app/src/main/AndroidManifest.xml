<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <!-- Required: without it JobScheduler rejects the sync framework's persisted job. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Needed for the unmetered-only rule and the "waiting for Wi-Fi" state (§8). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Terminal failures notify (§5); transient ones deliberately do not. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        §8's battery-optimisation exemption. Normal protection level, so there is no runtime grant
        to request: the declaration plus ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is the whole
        mechanism. Google Play restricts this permission to apps that declare a need for it, which
        a sync provider whose periodic job is suppressed has — but a listing would have to state
        that, so a published build must justify this row or drop it rather than leave the
        declaration in place quietly.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".DavProviderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.DavProvider">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AccountSetupActivity"
            android:exported="false"
            android:label="@string/title_add_account" />

        <!-- Reached from Settings only; it reads this app's own file and shows it to the user. -->
        <!-- One Collection's settings. Reached from its row on the accounts screen; the row
             carries the summary, this carries the switches and what they mean. -->
        <activity
            android:name=".ui.CollectionSettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.LogsActivity"
            android:exported="false" />

        <!-- Authenticator: holds the account the sync framework keys on. -->
        <service
            android:name=".account.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
            <!--
              Declared here as well as on the contacts sync-adapter service. AOSP's
              ExternalAccountType.loadContactsXml queries services answering
              android.content.SyncAdapter and takes the first CONTACTS_STRUCTURE it finds, so the
              sync-adapter service is enough there; an OEM fork that looks at the authenticator
              instead finds nothing. Declaring it twice costs one metadata entry.
            -->
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>

        <!-- Sync adapter: contacts authority -->
        <service
            android:name=".sync.ContactsSyncService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter_contacts" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>

        <!-- Sync adapter: calendar authority -->
        <service
            android:name=".sync.CalendarSyncService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter_calendar" />
        </service>

    </application>
</manifest>
