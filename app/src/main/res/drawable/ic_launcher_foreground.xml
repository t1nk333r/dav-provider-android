<?xml version="1.0" encoding="utf-8"?>
<!--
  A padlock whose shackle is a rotation arrow: security and sync in one mark, which is what this
  app is — a sync provider whose distinguishing feature is how it gets through the gate.

  Drawn on the adaptive grid: a 108dp canvas whose outer 18dp on every side the launcher may crop,
  so the whole mark sits inside the central 72dp and keeps its silhouette under any mask.

  The keyhole is a hole in the body, not a shape painted on top of it. Painting it in the
  background colour would look identical on this background and break the moment a launcher tints
  the icon or draws the monochrome layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The shackle, swept from the left and ending in a downward arrowhead. -->
    <path
        android:pathData="M 39 34 A 15 15 0 0 1 67 31"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="butt" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 61 26 L 78 30 L 67 43 Z" />

    <!-- The body, with the keyhole cut out of it. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,44 h28 a10,10 0 0 1 10,10 v18 a10,10 0 0 1 -10,10 h-28 a10,10 0 0 1 -10,-10 v-18 a10,10 0 0 1 10,-10 z M48,59 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0 z M51,61 h6 l-1.5,9 h-3 z" />
</vector>
