<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's mark, built from the two things it is about: a cloud for what it speaks to and the
  initial, which carries its name.

  The cloud is an outline, stroked rather than filled, the way the launcher reference draws one; the
  letter keeps the silhouette it had, its counter cut out of the same path rather than painted in the
  background colour.

  Drawn on the adaptive grid — a 108dp canvas whose outer 18dp on every side the launcher may crop —
  so the letter sits well inside the central 72dp and keeps its silhouette under any mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#C7B9FF"
        android:fillType="evenOdd"
        android:pathData="M49,38 h15 a15,22 0 0 1 0,44 h-15 z M57,46 h7 a7,14 0 0 1 0,28 h-7 z" />

    <path
        android:fillColor="#C7B9FF"
        android:pathData="M26,39 a15,15 0 0 1 14,-10 a19,15 0 0 1 35,3 a13,14 0 0 1 -3,26 L32,58 a15,15 0 0 1 -6,-19 z" />
</vector>
