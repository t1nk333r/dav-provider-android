<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's initial, drawn as one geometric shape: a stem and a single elliptical bowl, with the
  counter cut out of the same path rather than painted in the background colour.

  Drawn on the adaptive grid — a 108dp canvas whose outer 18dp on every side the launcher may crop —
  so the letter sits well inside the central 72dp and keeps its silhouette under any mask. The bowl
  is an ellipse rather than a circle so the letter can be tall enough to read at launcher size
  without growing wider than the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M36,24 h19 a19,30 0 0 1 0,60 h-19 z M46,34 h9 a9,20 0 0 1 0,40 h-9 z" />
</vector>
