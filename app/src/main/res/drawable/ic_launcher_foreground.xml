<?xml version="1.0" encoding="utf-8"?>
<!--
  A cloud with DAV written in it: the protocol, and the server it is spoken to.

  Drawn as strokes of one colour, so this same drawable is the Android 13 monochrome layer:
  the launcher tints every painted pixel and the letters stay legible because they are
  separated from the outline by a gap, not by a second colour.

  Geometry is measured, not eyeballed. The outline is the exact union of three circles closed
  by a flat base, so the arcs meet where the circles actually cross. The letters are the
  largest DAV that fits the interior with 1.5dp of clearance from the outline at every point,
  which is what stops them touching it at the shoulders.

  The launcher masks the central 72dp of this 108dp canvas, not the whole of it, so the mark
  has to live inside a 36dp radius of the centre — and a Pixel launcher crops to 34dp of it, measured. Its furthest painted point is 31.6dp,
  which is what keeps the dome and the base off the edge of a circular mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M39.41,72.24 A12.77,12.77 0 0 1 36.67,47.00 A17.33,17.33 0 0 1 71.26,45.14 A13.68,13.68 0 0 1 68.59,72.24 Z"
        android:strokeColor="#C7B9FF"
        android:strokeWidth="5.22"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M38.38,65.75 V53.25 H41.08 A6.25,6.25 0 0 1 41.08,65.75 Z"
        android:strokeColor="#C7B9FF"
        android:strokeWidth="3.99"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M49.52,65.75 L54.00,53.25 L58.48,65.75 M51.31,61.00 H56.69"
        android:strokeColor="#C7B9FF"
        android:strokeWidth="3.99"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M60.67,53.25 L65.15,65.75 L69.62,53.25"
        android:strokeColor="#C7B9FF"
