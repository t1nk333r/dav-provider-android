<?xml version="1.0" encoding="utf-8"?>
<!-- The window the log is printed in: a dark rounded panel, outlined by one hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/term_bg" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/term_border" />

</shape>
