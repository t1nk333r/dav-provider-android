<?xml version="1.0" encoding="utf-8"?>
<!-- The open list of a filter, drawn in the terminal's palette so the text stays legible in it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/term_bar" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/term_border" />

</shape>
