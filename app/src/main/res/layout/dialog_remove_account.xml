<?xml version="1.0" encoding="utf-8"?>
<!--
    What removal says, and the one choice it offers.

    The message is a view rather than the dialog's own: it has to read as one paragraph with the
    control under it, and the control is what turns the outcome from keeping the synced data to
    deleting it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/remove_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <CheckBox
        android:id="@+id/remove_also_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

</LinearLayout>
