<?xml version="1.0" encoding="utf-8"?>
<!--
  One URL, pasted. A Material 3 text field rather than a bare EditText, so the label is the field's
  own and the dialog does not have to set a hint the theme would then ignore.
-->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_input_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:hint="@string/collection_url_hint">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1" />

</com.google.android.material.textfield.TextInputLayout>
