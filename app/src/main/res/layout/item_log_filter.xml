<?xml version="1.0" encoding="utf-8"?>
<!--
  One value of a filter: what the selector shows, and what the open list shows.

  It is a themed text view like any other in the app — no colour of its own, so the open list and the
  selected value are drawn in the same on-surface colour the rest of the screen uses, in either mode.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:minHeight="44dp"
    android:paddingStart="12dp"
    android:paddingEnd="28dp"
    android:textAppearance="?attr/textAppearanceBodyMedium" />
