<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/account_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/account_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/account_last_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/account_certificate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/account_unmetered_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_only_unmetered" />

        <!-- Tapping opens the chooser; the row is the schedule's only display and only editor. -->
        <TextView
            android:id="@+id/account_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- The note belongs on the card rather than in the chooser: an AlertDialog shows either a
             message or a single-choice list, not both, and the reason the floor is where it is is
             worth having in front of the user before they open the chooser. -->
        <TextView
            android:id="@+id/account_interval_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_interval_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout
            android:id="@+id/account_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/waiting_for_wifi"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <Button
                android:id="@+id/account_sync_anyway"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sync_anyway" />
        </LinearLayout>

        <!--
            §8's exemption row. Shown only where there is evidence for it and the user has not
            answered it, so its presence is a fact about this Account's schedule rather than a
            standing request.
        -->
        <LinearLayout
            android:id="@+id/account_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/account_battery_evidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/account_battery_request"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_exempt" />

                <Button
                    android:id="@+id/account_battery_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/battery_dismiss" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/collections"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/account_no_collections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_collections"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/account_collections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/account_sync_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sync_now" />

            <Button
                android:id="@+id/account_diagnose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/diagnose"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/account_refresh_collections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh_collections" />

            <Button
                android:id="@+id/account_add_collection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add_collection" />

        </LinearLayout>

        <Button
            android:id="@+id/account_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove_account" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
