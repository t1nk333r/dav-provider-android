<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <View
        android:id="@+id/collection_color"
        android:layout_width="14dp"
        android:layout_height="14dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/collection_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/collection_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/collection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- Set from collection.writable. A Collection the user has not made writable is one the
             engine refuses to send edits for, so the row has to say so rather than leave the
             switch's position to be read as the answer. -->
        <TextView
            android:id="@+id/collection_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <!-- The per-Collection write switch, on the same row as the selection one: whether an edit
             made on the phone may be sent to the server for this Collection. Neither
             syncadapter_*.xml nor contacts.xml can be told about one Collection, so this switch is
             the whole of the user's say. -->
        <CheckBox
            android:id="@+id/collection_writable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collection_writable" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/collection_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/collection_select" />

</LinearLayout>
