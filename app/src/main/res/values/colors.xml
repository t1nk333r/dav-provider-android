<?xml version="1.0" encoding="utf-8"?>
<!--
  The log screen's colours, which are a terminal's rather than the theme's.

  The screen is one dark surface and the entries are the only thing on it that changes, so the
  chrome around them is quieter than the output is. The three levels are deliberately the classic
  red, yellow and green: a hundred lines are read by scanning for the red one, and nothing else on
  this screen is allowed to compete with it. A line this build cannot read is dim rather than red,
  because it is evidence the log holds rather than a failure the log reports.
-->
<resources>

    <!-- The terminal itself: the body it prints on, its title bar, and the one hairline that
         separates the parts. -->
    <color name="term_bg">#0D1117</color>
    <color name="term_bar">#161B22</color>
    <color name="term_border">#30363D</color>

    <!-- Output text, and the second rank of it: timestamps, the facts under a line, captions. -->
    <color name="term_text">#C9D1D9</color>
    <color name="term_dim">#8B949E</color>

    <!-- The level designators, and only they. -->
    <color name="level_error">#F85149</color>
    <color name="level_warn">#E3B341</color>
    <color name="level_info">#3FB950</color>

    <!-- The title bar's three lights. -->
    <color name="dot_red">#FF5F56</color>
    <color name="dot_yellow">#FFBD2E</color>
    <color name="dot_green">#27C93F</color>

</resources>
