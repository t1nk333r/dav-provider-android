<?xml version="1.0" encoding="utf-8"?>
<!--
  The log's own colours. Everything else on the screen — the background, the toolbar, the fields,
  the buttons, the panel's fill and its outline, the two ranks of text — is the app's theme, so the
  screen follows light and dark mode the way the rest of the app does.

  These three are the exception, and are semantic rather than decorative: red, yellow and green say
  ERROR, WARN and INFO, and a hundred lines are read by scanning for the red one. They are the same
  three colours in either mode because they are read as meaning, not as style.

  A line this build cannot read is not given one of these colours. It is dimmed with the theme's own
  on-surface-variant instead, because it is a raw line the log kept as evidence rather than a
  failure the log reports, and painting it yellow would claim the log called it a warning.
-->
<resources>

    <color name="level_error">#F85149</color>
    <color name="level_warn">#E3B341</color>
    <color name="level_info">#3FB950</color>

</resources>
