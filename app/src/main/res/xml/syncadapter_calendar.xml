<?xml version="1.0" encoding="utf-8"?>
<!-- supportsUploading="true" is what the framework reads: it now asks for an upload-only sync when
     a provider reports a dirtying write. It is not what a stock editor consults — the Calendar app
     offers a writable calendar from the access level the mapper writes on the Calendars row. -->
<sync-adapter xmlns:android="http://schemas.android.com/apk/res/android"
    android:contentAuthority="com.android.calendar"
    android:accountType="xyz.satr.davprovider"
    android:userVisible="true"
    android:supportsUploading="true"
    android:allowParallelSyncs="false"
    android:isAlwaysSyncable="true"
    android:settingsActivity="xyz.satr.davprovider.ui.SettingsActivity" />
